{
  "name": "waystation",
  "version": "0.6.0",
  "packageManager": "bun@1.4.1",
  "description": "Local-first task, issue, prompt, and handoff ledger for coordinating humans and AI coding agents.",
  "type": "module",
  "bin": {
    "waystation": "./src/cli/index.ts"
  },
  "scripts": {
    "waystation": "bun run src/cli/index.ts",
    "dashboard:build": "vite build --config src/dashboard/client/vite.config.ts",
    "build": "\"$npm_execpath\" run dashboard:build && \"$npm_execpath\" build --compile src/cli/index.ts --asset src/dashboard/client/dist --outfile waystation.exe",
    "test": "\"$npm_execpath\" test",
    "test:parallel": "\"$npm_execpath\" test --parallel=4 --isolate",
    "verify:fast": "\"$npm_execpath\" run --parallel test:parallel typecheck check",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15",
    "hono": "^4.13.5",
    "openai": "^6.49.0",
    "proper-lockfile": "^4",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "1.4.0",
    "@types/node": "^26.4.0",
    "@types/proper-lockfile": "^4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "typescript": "^6",
    "vite": "^8.2.2"
  },
  "engines": {
    "bun": ">=1.4.0 <1.5",
    "node": ">=22"
  }
}
